{
    "experiment_name": "weather_forecasting",
    "run_name": "transformer_h336_v2",
    "epochs": 15,
    "batch_size": 16,
    "learning_rate": 0.00015,
    "weight_decay": 0.0001,
    "early_stopping_patience": 5,
    "checkpoint_dir": "/app/artifacts",
    "device": "cpu",
    "data": {
        "parquet_path": "/app/data/spec",
        "target_columns": ["temp_ar_c"],
        "sequence_length": 672,
        "horizon": 336,
        "train_ratio": 0.8,
        "val_ratio": 0.1
    },
    "model": {
        "model_type": "transformer",
        "hidden_size": 256,
        "num_layers": 4,
        "num_heads": 8,
        "ffn_dim": 1024,
        "dropout": 0.2
    }
}
