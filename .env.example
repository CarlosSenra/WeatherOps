# WeatherOps — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores necessários.
#
# Uso:  cp .env.example .env
#
# Campos obrigatórios para a API de serving estão marcados com (obrigatório*).
# Os demais têm defaults razoáveis e podem ser omitidos.

# ── MLflow ─────────────────────────────────────────────────────────────────────
# URI do servidor MLflow. Vazio = file:///mlruns local (default).
# Exemplo remoto: http://mlflow-server:5000
MLFLOW_TRACKING_URI=

# ── Modelos Exportados ─────────────────────────────────────────────────────────
# Diretório com modelos exportados pelo promote (--export-dir).
# Se definido e existir a pasta <root>/<model_name>/MLmodel, a API carrega daqui
# antes de tentar o MLflow Registry (mais rápido, sem rede).
# Exemplo: src/api/ml_models  (relativo à raiz do repo)
# No Docker: /app/ml_models   (volume montado)
WEATHEROPS_MODEL_ROOT=

# ── Dados ──────────────────────────────────────────────────────────────────────
# Caminho para o arquivo Parquet ou diretório contendo Parquets de features.
# Gerado pelo pipeline: Airflow DAG data_feature_engineering → data/spec/<municipio>/
# No Docker: /app/data/spec   (volume montado)
PARQUET_PATH=/app/data/spec

# ── Inferência ─────────────────────────────────────────────────────────────────
# Dispositivo para inferência PyTorch. Use "cuda" se tiver GPU disponível.
DEVICE=cpu

# ── Cache ──────────────────────────────────────────────────────────────────────
# Backend do cache de previsões: "memory" (in-process) ou "redis".
# Use redis para múltiplos workers ou containers.
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=3600

# URL de conexão Redis (apenas quando CACHE_BACKEND=redis).
REDIS_URL=redis://localhost:6379

# ── Monitoramento de Qualidade ─────────────────────────────────────────────────
# Banco SQLite onde o PredictionLogger grava previsões e avaliações.
ACCURACY_DB_PATH=/app/data/accuracy.db

# Intervalo em segundos do AccuracyEvaluator (calcula MAE/RMSE/MAPE em background).
ACCURACY_EVAL_INTERVAL_SECONDS=3600

# ── Agente LLM (Gemini 2.5 Flash) ─────────────────────────────────────────────
# Obrigatório para o endpoint POST /v1/agent/chat.
# Obtenha gratuitamente em: https://aistudio.google.com/apikey
# Requer também: poetry install --only api,agent
GOOGLE_API_KEY=

# Tamanho máximo da mensagem de entrada do agente (caracteres).
AGENT_MAX_MESSAGE_CHARS=8000

# ── RAG — Base Vetorial do Agente ──────────────────────────────────────────────
# Diretório do ChromaDB gerado pelo promote com --update-knowledge-base.
# Se vazio, usa o default: src/api_agent/knowledge/chroma_db
# Gere com:
#   poetry run python -m src.ml_workstation.promotion.run_promote \
#       --experiment-name weather_tft_h72 \
#       --export-dir src/api/ml_models \
#       --update-knowledge-base
KNOWLEDGE_BASE_PATH=

# ── Airflow ────────────────────────────────────────────────────────────────────
# UID do usuário do sistema para o container Airflow (evita erros de permissão).
AIRFLOW_UID=50000

# E-mail para notificações do Airflow (opcional).
EMAIL=email@example.com
