# ── Agente LLM (Gemini 2.5 Flash) ─────────────────────────────────────────────
# Obrigatório para o endpoint POST /v1/agent/chat.
# Obtenha gratuitamente em: https://aistudio.google.com/apikey
# Requer também: poetry install --only api,agent
GOOGLE_API_KEY=

# ── Airflow ────────────────────────────────────────────────────────────────────
# UID do usuário do sistema para o container Airflow (evita erros de permissão).
AIRFLOW_UID=50000

# E-mail para notificações do Airflow (opcional).
EMAIL=email@example.com
